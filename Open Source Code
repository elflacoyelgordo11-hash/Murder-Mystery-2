MainTab:CreateToggle({
    Name = "Auto Farm Coins (Tween)",
    CurrentValue = false,
    Callback = function(value)
        coinTweenEnabled = value
        if not value then return end -- turning off just stops the loop below

        task.spawn(function()
            local char = Players.LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then
                Rayfield:Notify({
                    Title = "No character",
                    Content = "HumanoidRootPart not found.",
                    Duration = 4,
                })
                return
            end

            local done = {}
            while coinTweenEnabled do
                -- keep the character reference fresh across respawns
                char = Players.LocalPlayer.Character
                root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then
                    task.wait(0.5)
                else
                    local part = findClosestCoinServer(root.Position, done)
                    if not part then
                        task.wait(0.5) -- nothing new right now, check again shortly
                    else
                        local distance = (root.Position - part.Position).Magnitude
                        local time = math.max(distance / COIN_TWEEN_SPEED, 0.3)
                        local tween = TweenService:Create(
                            root,
                            TweenInfo.new(time, Enum.EasingStyle.Linear),
                            {CFrame = part.CFrame}
                        )
                        tween:Play()
                        tween.Completed:Wait()

                        pcall(function()
                            firetouchinterest(root, part, 0)
                            firetouchinterest(root, part, 1)
                        end)
                        done[part] = true
                        task.wait(COIN_DELAY)
                    end
                end
            end
        end)
    end,
})

MainTab:CreateToggle({
    Name = "Auto Farm Coins (Walk)",
    CurrentValue = false,
    Callback = function(value)
        coinWalkEnabled = value
        if not value then return end -- turning off just stops the loop below

        task.spawn(function()
            local char = Players.LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid then
                Rayfield:Notify({
                    Title = "No character",
                    Content = "HumanoidRootPart/Humanoid not found.",
                    Duration = 4,
                })
                return
            end

            local function isStillEnabled()
                return coinWalkEnabled
            end

            local done = {}
            while coinWalkEnabled do
                -- keep the character reference fresh across respawns
                char = Players.LocalPlayer.Character
                root = char and char:FindFirstChild("HumanoidRootPart")
                humanoid = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not humanoid then
                    task.wait(0.5)
                else
                    local part = findEasiestCoinServer(root.Position, done)
                    if not part then
                        task.wait(0.5) -- nothing new right now, check again shortly
                    else
                        -- WalkSpeed is left untouched here -- uses whatever speed
                        -- the game itself has set for the character

                        local reached = walkToPosition(humanoid, root, part.Position, isStillEnabled)

                        if reached and coinWalkEnabled then
                            pcall(function()
                                firetouchinterest(root, part, 0)
                                firetouchinterest(root, part, 1)
                            end)
                            done[part] = true
                            task.wait(COIN_DELAY)
                        elseif coinWalkEnabled then
                            -- couldn't reach this one (ran out of recompute attempts) --
                            -- give up on it permanently and move on to the next closest
                            done[part] = true
                            task.wait(0.3)
                        else
                            -- toggle was turned off mid-walk; just stop, don't mark done
                        end
                    end
                end
            end
        end)
    end,
})

