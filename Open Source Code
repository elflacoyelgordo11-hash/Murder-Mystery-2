-- Finds the closest part currently named "Coin_Server" that we haven't already fired
-- and that's within COIN_MAX_DISTANCE -- farther ones are skipped (not marked done,
-- so they'll naturally get picked up once they're close enough)
local function findClosestCoinServer(fromPos, done)
    local best, bestDist
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not done[obj] then
            local dist = (obj.Position - fromPos).Magnitude
            if dist <= COIN_MAX_DISTANCE and (not bestDist or dist < bestDist) then
                best, bestDist = obj, dist
            end
        end
    end
    return best
end

-- Watches root's position while waiting on a MoveTo and jumps if it stops making
-- progress for a short stretch -- catches obstacles in the way that the pathfinder's
-- own jump-waypoints don't account for (small ledges, debris, other players, etc.)
local STUCK_CHECK_INTERVAL = 0.3

-- Forces a single, clean jump: sets the Jump property AND explicitly changes the
-- humanoid's state, since on some custom character controllers a single Jump=true
-- can get missed. No repeated/held spam here -- that's what was causing the
-- stutter, bouncing the character every check while it was still mid-air from
-- the previous jump.
local function forceJump(humanoid)
    pcall(function()
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end

-- Waits for a single MoveTo to finish, jumping if stuck. Returns (reached, badlyStuck) --
-- badlyStuck means it went multiple consecutive checks with almost no progress even
-- after jumping, which signals the waypoint itself may be unreachable (e.g. the path
-- is clipping a wall) and the caller should recompute a fresh path rather than push on.
local STUCK_STREAK_FOR_RECOMPUTE = 3

local function waitForMoveTo(humanoid, root, isStillEnabled, timeout)
    local reached = false
    local conn
    conn = humanoid.MoveToFinished:Connect(function()
        reached = true
    end)

    local waited = 0
    local lastPos = root.Position
    local sinceLastCheck = 0
    local stuckStreak = 0
    local jumpedThisStreak = false

    while not reached and waited < timeout and isStillEnabled() do
        task.wait(0.1)
        waited += 0.1
        sinceLastCheck += 0.1

        if sinceLastCheck >= STUCK_CHECK_INTERVAL then
            sinceLastCheck = 0

            -- scale the "barely moved" threshold to the character's actual speed
            -- instead of a fixed stud count, so slower game-default WalkSpeeds
            -- don't get falsely flagged as stuck (which was also causing stutter)
            local expectedMove = (humanoid.WalkSpeed or 16) * STUCK_CHECK_INTERVAL
            local threshold = math.max(1, expectedMove * 0.35)

            local currentPos = root.Position
            if (currentPos - lastPos).Magnitude < threshold then
                stuckStreak += 1
                if not jumpedThisStreak then
                    -- only jump once per stuck episode, not every check, so it
                    -- doesn't keep re-triggering mid-air
                    forceJump(humanoid)
                    jumpedThisStreak = true
                end
            else
                stuckStreak = 0
                jumpedThisStreak = false
            end
            lastPos = currentPos

            if stuckStreak >= STUCK_STREAK_FOR_RECOMPUTE then
                conn:Disconnect()
                return false, true
            end
        end
    end

    conn:Disconnect()
    return reached, false
end

-- Walks a humanoid to destinationPos using PathfindingService, following waypoints
-- and jumping where needed. If progress stalls against something in the way (a wall
-- corner the path clipped, a moved obstacle, etc.) it recomputes a brand new path from
-- the character's current position instead of blindly continuing the stale one.
-- Returns true if it reached the end, false if it ran out of recompute attempts or
-- the farm got disabled mid-walk.
local MAX_RECOMPUTES = 5

local function computePathWaypoints(fromPos, destinationPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,       -- a bit wider than the character for wall clearance
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4,     -- wider spacing -- fewer re-aims per path = smoother movement
    })

    local ok = pcall(function()
        path:ComputeAsync(fromPos, destinationPos)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        return nil
    end

    return path:GetWaypoints()
end
-- Picks a coin from the closest few candidates, preferring whichever has the
-- "easiest" path rather than just the raw-distance closest: fewer jump waypoints
-- and a shorter actual walked route (not just straight-line distance) both count
-- against a coin's score. Only checks the EASIEST_CANDIDATE_COUNT closest coins
-- (not every coin in range) to keep this cheap -- it recomputes a path for each.
local EASIEST_CANDIDATE_COUNT = 5

local function findEasiestCoinServer(fromPos, done)
    local candidates = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not done[obj] then
            local dist = (obj.Position - fromPos).Magnitude
            if dist <= COIN_MAX_DISTANCE then
                table.insert(candidates, {part = obj, dist = dist})
            end
        end
    end

    if #candidates == 0 then
        return nil
    end

    table.sort(candidates, function(a, b)
        return a.dist < b.dist
    end)

    local bestPart, bestScore

    for i = 1, math.min(EASIEST_CANDIDATE_COUNT, #candidates) do
        local candidate = candidates[i]
        local waypoints = computePathWaypoints(fromPos, candidate.part.Position)

        local score
        if not waypoints then
            -- no valid path at all -- heavily penalize but don't fully exclude,
            -- in case every candidate turns out unreachable right now
            score = candidate.dist + 100000
        else
            local jumpCount = 0
            local pathLength = 0
            local prevPos = fromPos
            for _, wp in ipairs(waypoints) do
                if wp.Action == Enum.PathWaypointAction.Jump then
                    jumpCount += 1
                end
                pathLength += (wp.Position - prevPos).Magnitude
                prevPos = wp.Position
            end
            -- each jump counts as if it added 50 studs of "difficulty"
            score = pathLength + (jumpCount * 50)
        end

        if not bestScore or score < bestScore then
            bestScore = score
            bestPart = candidate.part
        end
    end

    return bestPart
end
-- Checks whether there's a clear line of sight (no solid, collidable obstruction)
-- between two points. Casts THREE parallel rays -- center, left edge, and right
-- edge, offset by the character's agent radius perpendicular to the direction of
-- travel -- instead of just one down the center. A single center ray can report
-- "clear" even when the character's actual body width would clip a wall corner;
-- checking both edges catches that.
local SIGHT_CHECK_RADIUS = 2.5 -- should match AgentRadius used for pathfinding

local function singleRayClear(fromPos, toPos, params)
    local direction = toPos - fromPos
    local result = workspace:Raycast(fromPos, direction, params)

    if not result then
        return true -- nothing in the way
    end
    -- something was hit before reaching toPos -- only a real obstruction if it's
    -- actually collidable (ignore decorative/non-collide clutter)
    if result.Instance and result.Instance.CanCollide == false then
        return true
    end

    return false
end

local function hasLineOfSight(fromPos, toPos, ignoreInstance)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ignoreInstance}
    params.IgnoreWater = true

    local flatDir = Vector3.new(toPos.X - fromPos.X, 0, toPos.Z - fromPos.Z)
    if flatDir.Magnitude < 0.01 then
        return singleRayClear(fromPos, toPos, params)
    end

    -- perpendicular (horizontal) offset vector, scaled to the agent's radius
    local perp = Vector3.new(-flatDir.Unit.Z, 0, flatDir.Unit.X) * SIGHT_CHECK_RADIUS

    local checks = {
        {fromPos, toPos},                           -- center
        {fromPos + perp, toPos + perp},             -- left edge
        {fromPos - perp, toPos - perp},              -- right edge
    }

    for _, pair in ipairs(checks) do
        if not singleRayClear(pair[1], pair[2], params) then
            return false
        end
    end

    return true
end
-- Takes the raw waypoints from the pathfinder and greedily skips ahead to the
-- farthest one it has clear line of sight to, cutting out unnecessary zig-zag
-- waypoints while still never routing through a wall (every skip is raycast-
-- verified first). Jump waypoints are never skipped over, since skipping would
-- lose the jump instruction.
local function simplifyWaypoints(waypoints, startPos, character)
    local simplified = {}
    local i = 1
    local n = #waypoints

    while i <= n do
        local current = waypoints[i]

        if current.Action == Enum.PathWaypointAction.Jump then
            -- never skip past a jump waypoint -- always keep it as-is
            table.insert(simplified, current)
            i += 1
        else
            local fromPos = (i == 1) and startPos or waypoints[i - 1].Position
            local farthest = i

            for j = n, i, -1 do
                if waypoints[j].Action == Enum.PathWaypointAction.Jump then
                    continue -- don't skip to/through a jump waypoint
                end
                if hasLineOfSight(fromPos, waypoints[j].Position, character) then
                    farthest = j
                    break
                end
            end

            table.insert(simplified, waypoints[farthest])
            i = farthest + 1
        end
    end

    return simplified
end
-- Last-resort recovery: tries walking the character directly away from wherever
-- it's wedged, in several directions, using raw Humanoid:Move (bypassing
-- pathfinding entirely) so it can't plan itself back into the same trap. This runs
-- whenever walkToPosition fully gives up on a coin, so the character doesn't stay
-- physically stuck in place for every subsequent coin attempt afterward.
local UNSTUCK_DIRECTIONS = {
    Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
    Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
    Vector3.new(1, 0, 1).Unit, Vector3.new(-1, 0, -1).Unit,
    Vector3.new(1, 0, -1).Unit, Vector3.new(-1, 0, 1).Unit,
}
local UNSTUCK_FREE_DISTANCE = 3 -- studs of actual movement that counts as "freed"

-- Checks a short distance ahead in a direction for anything solid, so the escape
-- maneuver only ever tries directions that are actually open instead of ramming
-- into whatever's already causing the problem.
local UNSTUCK_PROBE_DISTANCE = 4

local function isDirectionClear(root, character, dir)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true

    local result = workspace:Raycast(root.Position, dir.Unit * UNSTUCK_PROBE_DISTANCE, params)

    if not result then
        return true
    end

    return result.Instance and result.Instance.CanCollide == false
end

local function attemptUnstuck(humanoid, root, isStillEnabled)
    local character = humanoid.Parent

    -- only consider directions that are raycast-clear right now, so it never
    -- deliberately walks straight at the thing it's stuck on
    local openDirections = {}
    for _, dir in ipairs(UNSTUCK_DIRECTIONS) do
        if isDirectionClear(root, character, dir) then
            table.insert(openDirections, dir)
        end
    end

    if #openDirections == 0 then
        -- completely boxed in on all 8 sides -- walking won't help here
        return false
    end

    for _, dir in ipairs(openDirections) do
        if not isStillEnabled() then
            return false
        end

        local startPos = root.Position
        forceJump(humanoid)

        local elapsed = 0
        while elapsed < 0.4 and isStillEnabled() do
            -- re-check every tick in case this direction becomes blocked partway
            -- (e.g. it curves into a wall a couple studs further than the probe)
            if not isDirectionClear(root, character, dir) then
                break
            end
            pcall(function()
                humanoid:Move(dir, false)
            end)
            task.wait(0.1)
            elapsed += 0.1
        end

        pcall(function()
            humanoid:Move(Vector3.new(0, 0, 0), false)
        end)

        if (root.Position - startPos).Magnitude >= UNSTUCK_FREE_DISTANCE then
            return true -- moved enough to consider it freed
        end
    end

    return false -- tried every open direction, never meaningfully moved
end

local function walkToPosition(humanoid, root, destinationPos, isStillEnabled)
    local recomputes = 0

    while recomputes <= MAX_RECOMPUTES do
        if not isStillEnabled() then
            return false
        end

        local rawWaypoints = computePathWaypoints(root.Position, destinationPos)

        if not rawWaypoints then
            -- No valid path at all -- fall back to a direct MoveTo
            humanoid:MoveTo(destinationPos)
            return (waitForMoveTo(humanoid, root, isStillEnabled, 8))
        end

        local character = humanoid.Parent
        local waypoints = simplifyWaypoints(rawWaypoints, root.Position, character)

        local needsRecompute = false

        for _, waypoint in ipairs(waypoints) do
            if not isStillEnabled() then
                return false
            end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                forceJump(humanoid)
            end

            humanoid:MoveTo(waypoint.Position)

            local reached, badlyStuck = waitForMoveTo(humanoid, root, isStillEnabled, 3)

            if not isStillEnabled() then
                return false
            end

            if badlyStuck then
                needsRecompute = true
                break
            end

            if not reached then
                -- timed out without being flagged "badly" stuck -- still worth a
                -- recompute rather than pushing on to a waypoint that may no longer
                -- make sense from here
                needsRecompute = true
                break
            end
        end

        if not needsRecompute then
            return true -- reached every waypoint
        end

        recomputes += 1
        task.wait(0.2)
    end
    -- ran out of recompute attempts -- before giving up on this coin entirely,
    -- make sure the character isn't left physically wedged in place, or every
    -- future coin attempt from here will fail the same way
    attemptUnstuck(humanoid, root, isStillEnabled)

    return false
end
local espEnabled = false
local espHighlights = {}

local MainTab = Window:CreateTab("Main", nil)
