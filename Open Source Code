-- true if the player has the tool equipped or in their Backpack
local function hasTool(player, toolName)
    local char = player.Character
    if char and char:FindFirstChild(toolName) then
        return true
    end
    local backpack = player:FindFirstChild("Backpack")
    return backpack ~= nil and backpack:FindFirstChild(toolName) ~= nil
end
-- position to aim at (their root part), only if they're alive
local function getAimPos(player)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and hum and hum.Health > 0 then
        return root.Position
    end
end

local function makeArgs(originPos, targetPos)
    local lookFrom = originPos
    if (targetPos - originPos).Magnitude < 0.01 then
        lookFrom = originPos + Vector3.new(0, 0, 0.1)
    end
    return CFrame.lookAt(lookFrom, targetPos), CFrame.new(targetPos)
end
-- Wall check: true if nothing solid is between origin and the target.
-- Ignores all player characters and non-collidable parts (decor, invisible triggers).
local function hasClearShot(originPos, targetPos)
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    for _ = 1, 10 do
        params.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(originPos, targetPos - originPos, params)
        if not result then
            return true
        end
        if result.Instance.CanCollide then
            return false
        end
        table.insert(ignore, result.Instance)
    end

    return true
end
-- ================= Silent Aim =================
-- Is the position inside the cone in front of your camera? Returns (inFront, angleFromCrosshair)
local function getFrontAngle(pos)
    local cam = workspace.CurrentCamera
    if not cam then return false end

    local toTarget = pos - cam.CFrame.Position
    if toTarget.Magnitude < 0.01 then return true, 0 end

    local dot = math.clamp(cam.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)
    local angle = math.deg(math.acos(dot))
    return angle <= SILENT_AIM_FOV / 2, angle
end
-- Where your mouse/crosshair is pointing in the world
local function getMouseAimPos()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local loc = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(loc.X, loc.Y)
    local direction = ray.Direction * 1000

    local ignore = {}
    local lpChar = Players.LocalPlayer.Character
    if lpChar then
        table.insert(ignore, lpChar)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    for _ = 1, 10 do
        params.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(ray.Origin, direction, params)
        if not result then
            return ray.Origin + direction
        end
        if result.Instance.CanCollide then
            return result.Position
        end
        table.insert(ignore, result.Instance)
    end

    return ray.Origin + direction
end
-- Alive and inside the front-sight cone. Walls are checked after picking.
local function getFrontTarget(player)
    local pos = getAimPos(player)
    if not pos then return nil end

    local inFront, angle = getFrontAngle(pos)
    if not inFront then return nil end

    return pos, angle
end
-- Final aim position: the player if there's a clear line, otherwise wherever your mouse points
local function resolveAim(origin, targetPos)
    if hasClearShot(origin, targetPos) then
        return targetPos
    end
    return getMouseAimPos() or targetPos
end
-- Returns true if it replaced the game's call with its own
local function handleSilentAim(remote, ...)
    local args = {...}
    local lp = Players.LocalPlayer
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local origin = (typeof(args[1]) == "CFrame") and args[1].Position or myRoot.Position

    if remote.Name == "Shoot" and hasTool(lp, "Gun") then
        -- Sheriff: Knife holder closest to your crosshair (must be in front of you)
        local bestPos, bestAngle
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and hasTool(plr, "Knife") then
                local pos, angle = getFrontTarget(plr)
                if pos and (not bestAngle or angle < bestAngle) then
                    bestPos, bestAngle = pos, angle
                end
            end
        end

        if bestPos then
            local aimPos = resolveAim(origin, bestPos) -- behind a wall -> mouse position
            local a1, a2 = makeArgs(origin, aimPos)
            remote.FireServer(remote, a1, a2)
            return true
        end

    elseif remote.Name == "KnifeThrown" and hasTool(lp, "Knife") then
        -- Murderer: closest player in front of you and within range
        local bestPos, bestDist
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                local pos = getFrontTarget(plr)
                if pos then
                    local dist = (pos - myRoot.Position).Magnitude
                    if dist < SILENT_AIM_MAX_DISTANCE and (not bestDist or dist < bestDist) then
                        bestPos, bestDist = pos, dist
                    end
                end
            end
        end

        if bestPos then
            local aimPos = resolveAim(origin, bestPos) -- behind a wall -> mouse position
            local a1, a2 = makeArgs(origin, aimPos)
            remote.FireServer(remote, a1, a2)
            return true
        end
    end

    return false
end
-- Hook is installed AFTER handleSilentAim so it uses the final version
if hookmetamethod and newcclosure and getnamecallmethod and checkcaller then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if silentAimEnabled
            and getnamecallmethod() == "FireServer"
            and typeof(self) == "Instance"
            and not checkcaller()
            and (self.Name == "Shoot" or self.Name == "KnifeThrown")
        then
            local ok, handled = pcall(handleSilentAim, self, ...)
            if not ok then
                warn("[Silent Aim] Targeting failed: " .. tostring(handled))
            elseif handled then
                return
            end
        end
        return oldNamecall(self, ...)
    end))
end

