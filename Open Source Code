            firetouchinterest(root, drop, 1)
        end)

        task.wait(0.01) -- time for the pickup to register; raise if it misses

        if root.Parent then
            root.CFrame = origin
        end
    end,
})

-- true if the player has the tool equipped or in their Backpack
local function hasTool(player, toolName)
    local char = player.Character
    if char and char:FindFirstChild(toolName) then
        return true
    end
    local backpack = player:FindFirstChild("Backpack")
    return backpack ~= nil and backpack:FindFirstChild(toolName) ~= nil
end

-- position to aim at (their root part), only if they're alive
local function getAimPos(player)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and hum and hum.Health > 0 then
        return root.Position
    end
end

local function makeArgs(originPos, targetPos)
    local lookFrom = originPos
    if (targetPos - originPos).Magnitude < 0.01 then
        lookFrom = originPos + Vector3.new(0, 0, 0.1)
    end
    return CFrame.lookAt(lookFrom, targetPos), CFrame.new(targetPos)
end

-- Returns true if it replaced the game's call with its own
local function handleSilentAim(remote, ...)
    local args = {...}
    local lp = Players.LocalPlayer
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local origin = (typeof(args[1]) == "CFrame") and args[1].Position or myRoot.Position

    if remote.Name == "Shoot" and hasTool(lp, "Gun") then
        -- Sheriff: redirect the shot at whoever has the Knife
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and hasTool(plr, "Knife") then
                local pos = getAimPos(plr)
                if pos then
                    local a1, a2 = makeArgs(origin, pos)
                    remote.FireServer(remote, a1, a2)
                    return true
                end
            end
        end

    elseif remote.Name == "KnifeThrown" and hasTool(lp, "Knife") then
        -- Murderer: throw at everyone within range
        local fired = false
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                local pos = getAimPos(plr)
                if pos and (pos - myRoot.Position).Magnitude < SILENT_AIM_MAX_DISTANCE then
                    local a1, a2 = makeArgs(origin, pos)
                    remote.FireServer(remote, a1, a2)
                    fired = true
                end
            end
        end
        return fired
    end

    return false
end

if hookmetamethod and newcclosure and getnamecallmethod and checkcaller then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if silentAimEnabled
            and getnamecallmethod() == "FireServer"
            and typeof(self) == "Instance"
            and not checkcaller()
            and (self.Name == "Shoot" or self.Name == "KnifeThrown")
        then
            local ok, handled = pcall(handleSilentAim, self, ...)
            if ok and handled then
                return
            end
        end
        return oldNamecall(self, ...)
    end))
end

-- Wall check: true if nothing solid is between origin and the target.
-- Ignores all player characters and non-collidable parts (decor, invisible triggers).
local function hasLineOfSight(originPos, targetPos)
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    for _ = 1, 10 do
        params.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(originPos, targetPos - originPos, params)
        if not result then
            return true -- nothing in the way
        end
        if result.Instance.CanCollide then
            return false -- solid wall/obstacle
        end
        table.insert(ignore, result.Instance) -- skip non-collidable part and keep checking
    end

    return true
end

-- Returns true if it replaced the game's call with its own
local function handleSilentAim(remote, ...)
    local args = {...}
    local lp = Players.LocalPlayer
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local origin = (typeof(args[1]) == "CFrame") and args[1].Position or myRoot.Position

    if remote.Name == "Shoot" and hasTool(lp, "Gun") then
        -- Sheriff: redirect the shot at whoever has the Knife (only if there's a clear line)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and hasTool(plr, "Knife") then
                local pos = getAimPos(plr)
                if pos and hasLineOfSight(origin, pos) then
                    local a1, a2 = makeArgs(origin, pos)
                    remote.FireServer(remote, a1, a2)
                    return true
                end
            end
        end

    elseif remote.Name == "KnifeThrown" and hasTool(lp, "Knife") then
        -- Murderer: throw at the closest player in range that isn't behind a wall
        local bestPos, bestDist
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                local pos = getAimPos(plr)
                if pos then
                    local dist = (pos - myRoot.Position).Magnitude
                    if dist < SILENT_AIM_MAX_DISTANCE
                        and (not bestDist or dist < bestDist)
                        and hasLineOfSight(origin, pos)
                    then
                        bestPos, bestDist = pos, dist
                    end
                end
            end
        end

        if bestPos then
            local a1, a2 = makeArgs(origin, bestPos)
            remote.FireServer(remote, a1, a2)
            return true
        end
    end

    return false
end

-- Is the position inside the cone in front of your camera? Returns (inFront, angleFromCrosshair)
local function getFrontAngle(pos)
    local cam = workspace.CurrentCamera
    if not cam then return false end

    local toTarget = pos - cam.CFrame.Position
    if toTarget.Magnitude < 0.01 then return true, 0 end

    local dot = math.clamp(cam.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)
    local angle = math.deg(math.acos(dot))
    return angle <= SILENT_AIM_FOV / 2, angle
end

-- A player is a valid target only if they're alive, in front of you, and not behind a wall
local function isValidTarget(player, origin)
    local pos = getAimPos(player)
    if not pos then return nil end

    local inFront, angle = getFrontAngle(pos)
    if not inFront then return nil end

    if not hasLineOfSight(origin, pos) then return nil end

    return pos, angle
end

-- Returns true if it replaced the game's call with its own
local function handleSilentAim(remote, ...)
    local args = {...}
    local lp = Players.LocalPlayer
