local gunDropEspEnabled = false
local gunDropHighlights = {} -- [part] = Highlight instance
local gunDropWatcherConn = nil

local function addGunDropESP(part)
    if gunDropHighlights[part] then return end -- already has one

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.FillColor = Color3.fromRGB(255, 170, 0) -- orange
    highlight.OutlineColor = Color3.fromRGB(255, 170, 0)
    highlight.Parent = part

    gunDropHighlights[part] = highlight
    -- clean up automatically if the part itself gets destroyed/removed
    part.AncestryChanged:Connect(function(_, parent)
        if not parent and gunDropHighlights[part] then
            gunDropHighlights[part]:Destroy()
            gunDropHighlights[part] = nil
        end
    end)
end

local function removeGunDropESP(part)
    local highlight = gunDropHighlights[part]
    if highlight then
        highlight:Destroy()
        gunDropHighlights[part] = nil
    end
end

local function scanForGunDrops()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop" and obj:IsA("BasePart") then
            addGunDropESP(obj)
        end
    end
end

