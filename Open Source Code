-- Checks Character (equipped) and Backpack (own inventory only -- other players'
-- Backpacks are not replicated to your client by Roblox, so this will only catch
-- Knife/Gun for other players when they have it equipped, not sitting unequipped)
local function getHighlightColor(player, character)
    local hasKnife = character:FindFirstChild("Knife", true)
    local hasGun = character:FindFirstChild("Gun", true)

    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        hasKnife = hasKnife or backpack:FindFirstChild("Knife", true)
        hasGun = hasGun or backpack:FindFirstChild("Gun", true)
    end

    if hasKnife then
        return Color3.fromRGB(255, 0, 0) -- red
    elseif hasGun then
        return Color3.fromRGB(0, 0, 255) -- blue
    else
        return Color3.fromRGB(0, 255, 0) -- green
    end
end

local function addESP(player)
    if not espEnabled or espHighlights[player] or player.Parent ~= Players then return end

    local character = player.Character
    if not character then return end

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.FillColor = getHighlightColor(player, character)
    highlight.OutlineColor = highlight.FillColor
    highlight.Parent = character

    espHighlights[player] = highlight
    local connections = {}
    espConnections[player] = connections
    -- keep the color updated if they pick up/drop Knife or Gun later
    table.insert(connections, character.DescendantAdded:Connect(function()
        if espHighlights[player] then
            espHighlights[player].FillColor = getHighlightColor(player, character)
            espHighlights[player].OutlineColor = espHighlights[player].FillColor
        end
    end))
    table.insert(connections, character.DescendantRemoving:Connect(function()
        task.defer(function()
            if espHighlights[player] then
                espHighlights[player].FillColor = getHighlightColor(player, character)
                espHighlights[player].OutlineColor = espHighlights[player].FillColor
            end
        end)
    end))
    -- also react to the player's own Backpack changing (covers the LocalPlayer case)
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        table.insert(connections, backpack.ChildAdded:Connect(function()
            if espHighlights[player] then
                espHighlights[player].FillColor = getHighlightColor(player, character)
                espHighlights[player].OutlineColor = espHighlights[player].FillColor
            end
        end))
        table.insert(connections, backpack.ChildRemoved:Connect(function()
            if espHighlights[player] then
                espHighlights[player].FillColor = getHighlightColor(player, character)
                espHighlights[player].OutlineColor = espHighlights[player].FillColor
            end
        end))
    end
end

local function removeESP(player)
    local highlight = espHighlights[player]
    espHighlights[player] = nil
    local connections = espConnections[player]
    espConnections[player] = nil

    if connections then
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
    end

    if highlight then
        highlight:Destroy()
    end
end

local function refreshAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        removeESP(player)
        if player.Character then
            addESP(player)
        end
    end
end

local function watchPlayerESP(player)
    if espCharacterConnections[player] then return end

    espCharacterConnections[player] = player.CharacterAdded:Connect(function(character)
        if not espEnabled then return end

        removeESP(player)
        task.wait(0.2)
        if espEnabled and player.Parent == Players and player.Character == character then
            addESP(player)
        end
    end)

    if espEnabled and player.Character then
        addESP(player)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayerESP(player)
end

Players.PlayerAdded:Connect(watchPlayerESP)
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)

    local connection = espCharacterConnections[player]
    if connection then
        connection:Disconnect()
        espCharacterConnections[player] = nil
    end
end)

