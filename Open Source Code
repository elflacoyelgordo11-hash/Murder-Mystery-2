-- Finds a RemoteEvent by name: on the player, then anywhere in the game, then nil instances
local remoteCache = {}
local function findRemote(name)
    if remoteCache[name] then return remoteCache[name] end

    local found = Players.LocalPlayer:FindFirstChild(name)
    if not (found and found:IsA("RemoteEvent")) then
        found = nil
        for _, v in ipairs(game:GetDescendants()) do
            if v.Name == name and v:IsA("RemoteEvent") then
                found = v
                break
            end
        end
    end
    if not found and getnilinstances then
        for _, v in ipairs(getnilinstances()) do
            if v.Name == name and v:IsA("RemoteEvent") then
                found = v
                break
            end
        end
    end

    if found then remoteCache[name] = found end
    return found
end

local function fireAimed(remoteName, origin, pos)
    local remote = findRemote(remoteName)
    if remote then
        local a1, a2 = makeArgs(origin, pos)
