-- closest alive player holding a Knife (only visible to you when it's equipped)
local function findMurderer(fromPos)
    local lp = Players.LocalPlayer
    local best, bestPos, bestDist
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and hasTool(plr, "Knife") then
            local pos = getAimPos(plr)
            if pos then
                local dist = (pos - fromPos).Magnitude
                if not bestDist or dist < bestDist then
                    best, bestPos, bestDist = plr, pos, dist
                end
            end
        end
    end
    return best, bestPos, bestDist
end
-- Chasing: straight at them with a clear line, otherwise follow the next path waypoint
local lastChasePos, chaseStuckTicks = nil, 0
local function chaseStep(humanoid, root, targetPos)
    if lastChasePos and (root.Position - lastChasePos).Magnitude < 0.5 then
        chaseStuckTicks += 1
        if chaseStuckTicks >= 2 then
            forceJump(humanoid)
            chaseStuckTicks = 0
        end
    else
        chaseStuckTicks = 0
    end
    lastChasePos = root.Position

    if hasClearShot(root.Position, targetPos) then
        humanoid:MoveTo(targetPos)
        return
    end

    local waypoints = computePathWaypoints(root.Position, targetPos)
    local nextWp = waypoints and (waypoints[2] or waypoints[1])
    if nextWp then
        if nextWp.Action == Enum.PathWaypointAction.Jump then
            forceJump(humanoid)
        end
        humanoid:MoveTo(nextWp.Position)
    else
        humanoid:MoveTo(targetPos)
    end
end

local function stopMoving(humanoid, root)
    humanoid:MoveTo(root.Position)
end
-- An alive player with the Knife EQUIPPED who is close, or running toward you
local function findThreat(root, range)
    local lp = Players.LocalPlayer
    range = range or FLEE_RANGE
    local best, bestPos, bestDist

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            if char and char:FindFirstChild("Knife") then
                local theirRoot = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if theirRoot and hum and hum.Health > 0 then
                    local toMe = root.Position - theirRoot.Position
                    local dist = toMe.Magnitude
                    if dist <= range then
                        local vel = theirRoot.AssemblyLinearVelocity
                        local flatVel = Vector3.new(vel.X, 0, vel.Z)
                        local chasing = dist <= FLEE_CLOSE_RANGE

                        if not chasing and flatVel.Magnitude > 6 then
                            local flatToMe = Vector3.new(toMe.X, 0, toMe.Z)
                            if flatToMe.Magnitude > 0.01 then
                                chasing = flatVel.Unit:Dot(flatToMe.Unit) > 0.5 -- moving toward us
                            end
                        end

                        if chasing and (not bestDist or dist < bestDist) then
                            best, bestPos, bestDist = plr, theirRoot.Position, dist
                        end
                    end
                end
            end
        end
    end

    return best, bestPos, bestDist
end
-- Nothing solid in the way for `length` studs in direction `dir`
local function isRunClear(root, dir, length)
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = true

    local result = workspace:Raycast(root.Position, dir.Unit * length, params)
    return (not result) or (not result.Instance.CanCollide)
end
-- Ground exists under a point, so it doesn't run off the map edge
local function hasGround(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Players.LocalPlayer.Character}
    params.IgnoreWater = true
    return workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -30, 0), params) ~= nil
end

local function autoFleeStep(humanoid, root, threatPos)
    local now = tick()
    local dist = (root.Position - threatPos).Magnitude

    local away = Vector3.new(root.Position.X - threatPos.X, 0, root.Position.Z - threatPos.Z)
    if away.Magnitude < 0.01 then
        away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
    end
    away = away.Unit
    -- juke in progress: keep sidestepping until it ends or hits a wall
    if now < jukeUntil and jukeDir then
        if isRunClear(root, jukeDir, 12) then
            humanoid:MoveTo(root.Position + jukeDir * 16)
            return
        end
        jukeUntil = 0
    -- start a new juke every so often once the chaser gets close
    elseif now >= nextJukeAt and dist <= 30 then
        nextJukeAt = now + 1.2 + math.random() * 2
        local side = (math.random() < 0.5) and 1 or -1
        local perp = Vector3.new(-away.Z, 0, away.X) * side
        local dir = (perp + away * 0.3).Unit -- mostly sideways, cuts across their line

        if isRunClear(root, dir, 12) and hasGround(root.Position + dir * 12) then
            jukeDir = dir
            jukeUntil = now + 0.45
            if math.random() < 0.5 then
                forceJump(humanoid)
            end
            humanoid:MoveTo(root.Position + dir * 16)
            return
        end
    end
    -- run away: straight back first, then fan out left/right until something is open
    for _, deg in ipairs({0, 25, -25, 50, -50, 80, -80, 120, -120}) do
        local rad = math.rad(deg)
        local c, s = math.cos(rad), math.sin(rad)
        local dir = Vector3.new(away.X * c - away.Z * s, 0, away.X * s + away.Z * c)

        if isRunClear(root, dir, 18) and hasGround(root.Position + dir * 18) then
            humanoid:MoveTo(root.Position + dir * 25)
            return
        end
    end
    -- boxed in on every side: jump and try to wriggle free
    forceJump(humanoid)
    attemptUnstuck(humanoid, root, function() return autoPlayEnabled end)
end
-- No gear: GunDrop first, then sometimes the nearest coin, otherwise wander
local function autoIdleStep(humanoid, root, startRole)
    local function stillOk()
        if not autoPlayEnabled or getRole() ~= startRole then return false end
        if startRole == "gun" and findMurderer(root.Position) then return false end
        if startRole == "none" then
            if findThreat(root) then return false end -- chaser appeared, stop and run
            local drop = getGunDrop()
            if drop and (drop.Position - root.Position).Magnitude <= AUTO_MAX_DISTANCE then
                return false
            end
        end
        return true
    end

    if startRole == "none" then
        local drop = getGunDrop()
        if drop and (drop.Position - root.Position).Magnitude <= AUTO_MAX_DISTANCE then
            local function dropOk()
                return autoPlayEnabled
                    and getRole() == "none"
                    and drop:IsDescendantOf(workspace)
                    and not findThreat(root, 15) -- only bail out if the chaser is right on top of us
            end

            walkToPosition(humanoid, root, drop.Position, dropOk)

            if dropOk() then
                pcall(function()
                    firetouchinterest(root, drop, 0)
                    firetouchinterest(root, drop, 1)
                end)
                task.wait(0.3)
            end
            return
        end
    end
    -- sometimes go for the nearest coin
    if math.random() < 0.6 then
        local coin = findEasiestCoinServer(root.Position, autoCoinDone)
        if coin then
            local reached = walkToPosition(humanoid, root, coin.Position, stillOk)
            if reached and stillOk() then
                pcall(function()
                    firetouchinterest(root, coin, 0)
                    firetouchinterest(root, coin, 1)
                end)
                autoCoinDone[coin] = true
            elseif stillOk() then
                autoCoinDone[coin] = true -- unreachable, don't retry it
            end
            task.wait(0.2)
            return
        end
    end
    -- otherwise wander to a random nearby spot
    local angle = math.random() * math.pi * 2
    local dist = math.random(25, 70)
    local dest = root.Position + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
    walkToPosition(humanoid, root, dest, stillOk)
end
-- Sheriff: find the Knife holder, chase until there's a clear line, then shoot
local function autoGunStep(humanoid, root, char)
    equipTool(humanoid, char, "Gun")

    local _, pos, dist = findMurderer(root.Position)
    if not pos then
        autoIdleStep(humanoid, root, "gun") -- murderer not visible to us, keep busy
        return
    end

    local origin = (char:FindFirstChild("Head") or root).Position
    local los = hasClearShot(origin, pos)

    if los and dist <= AUTO_SHOOT_RANGE and tick() - lastShot >= AUTO_SHOOT_COOLDOWN then
        lastShot = tick()
        fireAimed("Shoot", origin, pos)
    end

    if los and dist <= AUTO_SHOOT_STANDOFF then
        stopMoving(humanoid, root)
    else
        chaseStep(humanoid, root, pos)
    end
    task.wait(0.15)
end
-- Murderer: throw at everyone in range with a clear line, chase the closest, stab when close
local function autoKnifeStep(humanoid, root, char)
    local tool = equipTool(humanoid, char, "Knife")
    local lp = Players.LocalPlayer
    local origin = (char:FindFirstChild("Head") or root).Position

    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local pos = getAimPos(plr)
            if pos then
                local dist = (pos - root.Position).Magnitude
                if dist <= AUTO_MAX_DISTANCE then
                    table.insert(targets, {pos = pos, dist = dist})
                end
            end
        end
    end

    if #targets == 0 then
        autoIdleStep(humanoid, root, "knife")
        return
    end

    table.sort(targets, function(a, b) return a.dist < b.dist end)

    if tick() - lastThrow >= AUTO_THROW_COOLDOWN then
        local threw = false
        for _, t in ipairs(targets) do
            if hasClearShot(origin, t.pos) then
                fireAimed("KnifeThrown", origin, t.pos)
                threw = true
            end
        end
        if threw then lastThrow = tick() end
    end

    local closest = targets[1]
    chaseStep(humanoid, root, closest.pos)

    if closest.dist <= AUTO_STAB_RANGE and tool and tool:IsA("Tool") and tool.Parent == char then
        pcall(function() tool:Activate() end)
    end

    task.wait(0.15)
end

local function startAutoPlay()
    autoPlayToken += 1
    local myToken = autoPlayToken

    task.spawn(function()
        while autoPlayEnabled and autoPlayToken == myToken do
            local char = Players.LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if not root or not humanoid or humanoid.Health <= 0 then
                task.wait(0.5)
            else
                local ok, err = pcall(function()
                    local role = getRole()
                    if role == "knife" then
                        autoKnifeStep(humanoid, root, char)
                    elseif role == "gun" then
                        autoGunStep(humanoid, root, char)
                    else
                        local _, threatPos = findThreat(root)
                        if threatPos then
                            autoFleeStep(humanoid, root, threatPos)
                            task.wait(0.1)
                        else
                            autoIdleStep(humanoid, root, "none")
                        end
                    end
                end)
                if not ok then
                    warn("[Auto Play] " .. tostring(err))
                    task.wait(0.5)
                end
                task.wait(0.1)
            end
        end
    end)
end

