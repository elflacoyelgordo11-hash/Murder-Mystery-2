local function findGunDropPart(fromPosition, maxDistance)
    local closestDrop, closestDistance
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop" and obj:IsA("BasePart") then
            if not fromPosition or not maxDistance then
